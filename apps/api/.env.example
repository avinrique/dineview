# Database
DATABASE_URL="postgresql://dineview:dineview_dev@localhost:5432/dineview?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-access-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_SESSION_SECRET="your-session-secret-change-in-production"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="dineview"
S3_SECRET_KEY="dineview_dev"
S3_BUCKET="dineview-assets"
S3_REGION="us-east-1"
