# Database (docker maps host 5433 -> container 5432)
DATABASE_URL="postgresql://dineview:dineview_dev@localhost:5433/dineview?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-access-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_SESSION_SECRET="your-session-secret-change-in-production"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Public URL of the web app (encoded into table QR codes). Defaults to the
# first CORS_ORIGIN.
# WEB_URL="https://dineview.example.com"

# `/scan/demo` opens a table at this restaurant (powers the landing-page demo).
# Remove in production if you don't want a public demo.
DEMO_RESTAURANT_SLUG="bella-vista"

# Dish photos and 3D models uploaded from the admin panel
UPLOAD_DIR="./uploads"
